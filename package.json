{
  "name": "dsh-cost-speed",
  "version": "0.2.1",
  "description": "DeepSeek Harness 计费与速度面板：按真实 BPE 估算 token 成本，显示流式 TPS、首字延迟与上下文占用，支持时/日/周/月四视图；Local cost and speed monitor for DSH with a user-editable price table.",
  "license": "MIT",
  "author": "Unstivl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unstivl/dsh-cost-speed.git"
  },
  "homepage": "https://github.com/Unstivl/dsh-cost-speed#readme",
  "bugs": {
    "url": "https://github.com/Unstivl/dsh-cost-speed/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/tokenizer",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "billing",
    "tokens",
    "tps",
    "usage",
    "monitor",
    "计费",
    "用量"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3 <0.3.0"
    }
  }
}